{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v3/implementation/registry/package.schema.json",
  "title": "emage.code v3 knowledge package metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "name", "version", "description", "contentPath", "compatibility"],
  "properties": {
    "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "packId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 10},
    "contentPath": {"type": "string", "minLength": 1},
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedPlatforms"],
      "properties": {
        "supportedPlatforms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["github", "gemini", "opencode", "cursor"]}
        }
      }
    }
  }
}
