{
  "$schema": "./_manifest.schema.json",
  "platform": "pi",
  "displayName": "Pi",
  "outputDir": ".pi",
  "fileMap": {
    "agents":       { "dir": "agents",       "ext": ".md" },
    "commands":     { "dir": "prompts",      "ext": ".md" },
    "instructions": { "dir": "instructions", "ext": ".md" },
    "skills":       { "dir": "skills",       "preserveTree": true }
  },
  "frontmatter": {
    "agents": {
      "tools": "array",
      "keepKeys": ["name", "description", "tools", "agents"]
    },
    "commands": {
      "keepKeys": ["description", "argument-hint"]
    },
    "instructions": {
      "keepKeys": ["description", "applyTo"]
    },
    "skills": {
      "keepKeys": ["name", "description"]
    }
  },
  "mcp": {
    "tags": ["core", "extended"],
    "outputFile": "mcp.json",
    "format": "cursor"
  }
}
