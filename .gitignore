# ────────────────────────────────────────────────────────────────────────────
# emage.code root .gitignore
# ────────────────────────────────────────────────────────────────────────────

# Node / npm
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / dist
dist/
build/
out/
.cache/

# Logs / temp
*.log
.tmp/
tmp/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Ed25519 witness signing keys — private key material is NEVER committed (T232).
# Public keys (*.pub) are allowed so verification works in CI.
*.ed25519.key
deploy/keys/
**/keys/*.key

# scripts/deploy/cwso-docker-desktop.sh generates deploy/local-dev/ at runtime as a working
# copy of deploy/docker-compose-t226.yml + deploy/t226-phase2.env (including the JWT secret
# reference) — never a source-controlled directory.
deploy/local-dev/

# OS cruft
.DS_Store
Thumbs.db
*.swp
*.swo

# WSL/Windows zone identifiers
*:Zone.Identifier

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
!.vscode/mcp.json.provenance.json
.history/

# Claude Code CLI runtime settings at repo root (session/local tool state,
# /.claude/
# .claude/settings.json
.claude/settings.local.json

# Python (in case generators or scripts use it)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage / test artifacts
coverage/
.coverage
*.cover
htmlcov/
junit.xml
report.xml
test-results/

# Lockfiles — keep package-lock.json for reproducibility, ignore others
yarn.lock

# Memory / agent runtime scratch (per-agent local state)
/memories/session/

# OS generated by AI tooling
.aider*
.cursor-tutor/
output.json
