# ────────────────────────────────────────────────────────────────────────────
# emage.code root .gitignore
# ────────────────────────────────────────────────────────────────────────────

# Node / npm
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / dist
dist/
build/
out/
.cache/

# Logs / temp
*.log
.tmp/
tmp/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# OS cruft
.DS_Store
Thumbs.db
*.swp
*.swo

# WSL/Windows zone identifiers
*:Zone.Identifier

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.history/

# Python (in case generators or scripts use it)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage / test artifacts
coverage/
.coverage
*.cover
htmlcov/
junit.xml
report.xml
test-results/

# Lockfiles — keep package-lock.json for reproducibility, ignore others
yarn.lock

# Memory / agent runtime scratch (per-agent local state)
/memories/session/

# OS generated by AI tooling
.aider*
.cursor-tutor/
