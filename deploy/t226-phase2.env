# T226 Infrastructure Deployment: Environment Variables
#
# This file contains environment variables for deploying CWSO + Polar
# infrastructure locally with rollout enabled for Phase 2 live integration testing.
#
# Usage:
#   source deploy/t226-phase2.env
#   docker compose -f deploy/docker-compose-t226.yml up -d
#
# All secrets are injected at runtime via environment variables only.
# No credentials are committed to the repository.

# ==============================================================================
# CWSO Orchestrator Configuration
# ==============================================================================

# Logging level (debug, info, warn, error)
CWSO_LOG_LEVEL=info
RUST_LOG=info

# ==============================================================================
# Rollout Proxy Configuration (Phase 2)
# ==============================================================================

# HTTP bind address and port for rollout proxy
# The harness (T223) and reward attachment (T224) will call this endpoint
CWSO_ROLLOUT_HTTP_BIND_PORT=8787

# Upstream model endpoint for LLM calls
# This can point to:
#   - A local mock OpenAI server (http://127.0.0.1:18080)
#   - A real LLM provider (OpenAI, Anthropic, etc.)
#   - Empty string defaults to first provider in config
CWSO_ROLLOUT_UPSTREAM_URL=http://127.0.0.1:18080

# Optional: API key for upstream endpoint (if required)
# Leave empty if upstream doesn't require authentication
# NOTE: Do NOT commit actual keys; inject via `export` before docker compose up
CWSO_ROLLOUT_UPSTREAM_API_KEY=

# ==============================================================================
# Parquet Trajectory Store Configuration (Polar)
# ==============================================================================

# Enable Parquet capture (required for Phase 2 live integration testing)
CWSO_ROLLOUT_TRAJECTORY_STORE_ENABLED=true

# Path where Parquet files are stored (inside container)
# This is mounted to the host at PARQUET_STORE_HOST_PATH
CWSO_ROLLOUT_TRAJECTORY_STORE_PATH=/data/parquet-store

# Host path where Parquet store is mounted (accessible from T228 live integration tests)
# Default: /tmp/t226-parquet-store
# Can be overridden to a persistent location if needed
PARQUET_STORE_HOST_PATH=/tmp/t226-parquet-store

# Enable trajectory capture (records LLM calls in Parquet)
CWSO_ROLLOUT_CAPTURE_ENABLED=true

# Session ID for grouping trajectories (can be overridden per-dispatch)
CWSO_ROLLOUT_DEFAULT_SESSION_ID=t226-live-session

# ==============================================================================
# Phase 2: Execution Gateway & Trajectory Builder
# ==============================================================================

# Enable session execution gateway (INIT/READY/RUNNING/POSTRUN pools)
# This is required for tasks submitted to /rollout/task/submit to actually execute
CWSO_ROLLOUT_GATEWAY_STAGING_ENABLED=true

# Enable post-run evaluator registry (required for rewards + evaluation)
CWSO_ROLLOUT_EVALUATOR_REGISTRY_ENABLED=true

# Enable trajectory builder for Parquet capture (required for Phase 4 data collection)
CWSO_ROLLOUT_TRAJECTORY_BUILDER_ENABLED=true

# Trajectory builder strategy: "per_request" or "prefix_merge" (default: prefix_merge)
CWSO_ROLLOUT_TRAJECTORY_BUILDER_STRATEGY=per_request

# ==============================================================================
# JWT Authentication (MCP Endpoint)
# ==============================================================================

# CWSO uses JWT for MCP endpoint authentication
# Dev JWT secret is stored at /home/emage/Code/emage/CWSO/.env.jwt.dev
# The docker-compose.yml mounts this as a secret
#
# For local testing, you may set CWSO_JWT_SECRET in your shell:
# export CWSO_JWT_SECRET=$(cat /home/emage/Code/emage/CWSO/.env.jwt.dev)

# ==============================================================================
# SIA Harness Integration (T223)
# ==============================================================================

# The SIA harness launcher (T223) expects these environment variables:
#   - CWSO_BASE_URL=http://localhost:8080  (CWSO orchestrator)
#   - CWSO_JWT_SECRET=<token>              (for MCP auth)
#
# Set these in your shell before running the harness:
# export CWSO_BASE_URL=http://localhost:8080
# export CWSO_JWT_SECRET=$(cat /home/emage/Code/emage/CWSO/.env.jwt.dev)

# ==============================================================================
# Reward Attachment & Shaping (T224, T225)
# ==============================================================================

# T224 (Reward Attachment) environment variables:
#   - CWSO_BASE_URL=http://localhost:8080  (same as above)
#   - CWSO_JWT_SECRET=<token>              (same as above)

# T225 (Reward Shaping) environment variables:
#   - REWARD_SHAPING_W_MERGE (default: 0.5): weight for merge signal
#   - REWARD_SHAPING_W_EVAL (default: 0.5): weight for eval metric

# Example (both 0.5 weights = equal blend of merge and eval signals):
# export REWARD_SHAPING_W_MERGE=0.5
# export REWARD_SHAPING_W_EVAL=0.5

# ==============================================================================
# Deployment Steps
# ==============================================================================

# 1) Create Parquet store directory on host
#    mkdir -p /tmp/t226-parquet-store

# 2) Start CWSO infrastructure
#    docker compose -f deploy/docker-compose-t226.yml up -d

# 3) Verify health
#    curl http://localhost:8080/healthz

# 4) Export JWT for local testing
#    export CWSO_JWT_SECRET=$(cat ../CWSO/.env.jwt.dev)
#    export CWSO_BASE_URL=http://localhost:8080

# 5) Run SIA dispatch test (see implementation/scripts/dispatch-test-sia.py)

# 6) Query Parquet trajectories
#    python3 -c "import pyarrow.parquet as pq; \
#      table = pq.read_table('/tmp/t226-parquet-store/...'); \
#      print(table.schema)"

# 7) Teardown
#    docker compose -f deploy/docker-compose-t226.yml down
