{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "instructions/coding-standards.md",
    "instructions/git-workflow.md",
    "instructions/security-guidelines.md",
    "instructions/poc-guidelines.md"
  ],
  "mcp": {
    "gitlab": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@zereight/mcp-gitlab@2.2.5"
      ],
      "environment": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "{env:GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "{env:GITLAB_API_URL}"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.83"
      ]
    },
    "fetch": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-fetch-server@1.1.2"
      ]
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory@1.0.0"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking@1.0.0"
      ]
    },
    "brave": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@brave/brave-search-mcp-server@2.1.4"
      ],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "hindsight": {
      "type": "remote",
      "url": "{env:HINDSIGHT_MCP_URL}"
    },
    "cwso": {
      "type": "remote",
      "url": "{env:CWSO_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:CWSO_BEARER_TOKEN}",
        "Origin": "{env:CWSO_ORIGIN}"
      }
    },
    "hf-mcp-server": {
      "type": "remote",
      "url": "https://huggingface.co/mcp?login"
    },
    "context-retriever": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "implementation.runtime.memory.context_retriever_mcp_server",
        "--index-dir",
        "implementation/runtime/memory/_index/em-age-emage.code",
        "--workspace-root",
        ".",
        "--platform-root",
        ".claude"
      ]
    },
    "security-audit": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "implementation.runtime.security.audit_server"
      ]
    },
    "poc-security-audit": {
      "type": "local",
      "command": [
        "python3",
        "-m",
        "implementation.runtime.security.poc_audit_server",
        "--allowed-root",
        "."
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@1.0.0",
        "."
      ]
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server@sha256:ffced0d76e77428532a2ced185516992d77fd146d69eec2f244e6237d1a97796"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git@2026.10.10",
        "--repository",
        "."
      ]
    },
    "supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-supabase@0.13.0",
        "--read-only"
      ],
      "environment": {
        "SUPABASE_ACCESS_TOKEN": "{env:SUPABASE_ACCESS_TOKEN}"
      }
    },
    "toolradar": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "toolradar-mcp@2.1.0"
      ],
      "environment": {
        "TOOLRADAR_API_KEY": "{env:TOOLRADAR_API_KEY}"
      }
    }
  }
}
