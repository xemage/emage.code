{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v3/runtime/telemetry/schema-v1.json",
  "title": "emage.code telemetry trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "events"],
  "properties": {
    "schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "runId", "step", "timestamp", "agent", "eventType", "payload"],
        "properties": {
          "eventId": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
          "runId": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
          "step": {"type": "integer", "minimum": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "agent": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
          "eventType": {"type": "string", "enum": ["step", "tool", "handoff", "verdict"]},
          "payload": {"type": "object"}
        }
      }
    }
  }
}
