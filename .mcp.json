{
  "mcpServers": {
    "hindsight": {
      "type": "http",
      "url": "${HINDSIGHT_MCP_URL}"
    },
    "cwso": {
      "type": "http",
      "url": "${CWSO_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${CWSO_BEARER_TOKEN}",
        "Origin": "${CWSO_ORIGIN}"
      }
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "${GITLAB_API_URL}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "fetch": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-fetch-server"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "brave": {
      "command": "npx",
      "args": [
        "-y",
        "@brave/brave-search-mcp-server"
      ],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "hf-mcp-server": {
      "type": "http",
      "url": "https://huggingface.co/mcp?login"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-filesystem"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@github/mcp-github"
      ]
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/mcp-git"
      ]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp"
      ]
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "docker-mcp"
      ]
    },
    "postgresql": {
      "command": "npx",
      "args": [
        "-y",
        "postgres-mcp"
      ]
    },
    "toolradar": {
      "command": "npx",
      "args": [
        "-y",
        "toolradar-mcp"
      ],
      "env": {
        "TOOLRADAR_API_KEY": "${TOOLRADAR_API_KEY}"
      }
    },
    "context-retriever": {
      "command": "python3",
      "args": [
        "-m",
        "implementation.runtime.memory.context_retriever_mcp_server",
        "--index-dir",
        "implementation/runtime/memory/_index/em-age-emage.code",
        "--workspace-root",
        ".",
        "--platform-root",
        ".claude"
      ]
    },
    "security-audit": {
      "command": "python3",
      "args": [
        "-m",
        "implementation.runtime.security.audit_server"
      ]
    },
    "poc-security-audit": {
      "command": "python3",
      "args": [
        "-m",
        "implementation.runtime.security.poc_audit_server",
        "--allowed-root",
        "."
      ]
    }
  }
}
